---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Scribble from '../components/Scribble.astro';
import mascotte from '../assets/brand/mascotte.png';
import illusRemuneration from '../assets/illus/atout-remuneration.png';
import illusCompetences from '../assets/illus/atout-competences.png';
import illusProjets from '../assets/illus/atout-projets.png';
import illusSophia from '../assets/illus/atout-sophia.png';
import illusAmbiance from '../assets/illus/valeur-solidarite.png';
import { company } from '../data/company';

const atouts = [
	{
		illus: illusRemuneration,
		name: 'Une rémunération attractive',
		description:
			'Une rémunération adaptée à votre expérience, vos compétences et votre parcours.',
	},
	{
		illus: illusCompetences,
		name: 'Continuer à progresser',
		description:
			'Formations, nouvelles technologies et partage d’expérience pour continuer à développer vos compétences au fil des missions.',
	},
	{
		illus: illusAmbiance,
		name: 'Une bonne ambiance',
		description:
			'Des sorties, des événements et des moments conviviaux pour se retrouver régulièrement en dehors des projets.',
	},
	{
		illus: illusProjets,
		name: 'Des missions variées',
		description:
			'Automobile, aérien, défense, espace, télécommunications… Des environnements différents et des projets principalement orientés développement logiciel.',
	},
	{
		illus: illusSophia,
		name: 'Une région qui a tout pour plaire',
		description:
			'Nos consultants interviennent chez des clients situés entre Cannes et Nice, au cœur de la Côte d’Azur. Des missions techniques dans un cadre qui permet aussi de profiter de la mer et de la montagne.',
	},
];

/**
 * Le fil qui relie une carte à la mascotte, relevé sur la maquette : il part
 * du point posé sur le bord intérieur de la carte, file à l'horizontale puis
 * s'infléchit vers le centre. Le tracé plongeant sert aux cartes du haut ; CSS
 * le retourne pour la colonne de droite et pour les cartes du bas.
 */
const FIL = 'M11 7C30 10 48 15 74 28';
/** Une carte encadrée par deux autres est déjà à hauteur de mascotte : son fil
 *  file quasiment droit, là où celui des extrémités plonge ou remonte. */
const FIL_PLAT = 'M11 7C30 8 48 9 74 10';

/**
 * Oriente le fil selon la place de la carte dans sa colonne, plutôt que par
 * un `.perk + .perk` en CSS : celui-ci visait « toute carte sauf la première »
 * et faisait remonter les fils des deuxième et troisième cartes dès qu'une
 * colonne en comptait plus de deux.
 */
const filDe = (i: number, total: number) => ({
	d: i === 0 || i === total - 1 ? FIL : FIL_PLAT,
	remonte: total > 1 && i === total - 1,
});

const atoutsGauche = atouts.slice(0, 3);
const atoutsDroite = atouts.slice(3);

const objet = encodeURIComponent('Candidature spontanée');
const corps = encodeURIComponent(
	"Bonjour,\n\nJe vous écris pour une candidature spontanée.\n\nPoste recherché :\nDisponibilité :\n\n(Pensez à joindre votre CV à ce message.)\n\nCordialement,"
);
/** Le même brouillon prérempli sert au bouton sous la mascotte et au bloc du bas. */
const mailtoCandidature = `mailto:${company.email}?subject=${objet}&body=${corps}`;
---

<BaseLayout
	title="Nous rejoindre"
	description="Vous cherchez un nouveau défi professionnel et une rémunération au-dessus du prix du marché ? Blueberry Digital Services recrute à Sophia-Antipolis."
>
	<section class="join-hero">
		<div class="container join-hero__inner">
			<div class="join-hero__text">
				<h1>Pourquoi rejoindre <span class="accent-word">Blueberry</span></h1>
				<p class="lead">
					Des missions techniques, des clients variés et une structure à taille humaine. Voici ce
					que nous proposons à nos consultants.
				</p>
			</div>

			<Scribble
				text="Votre prochain projet est peut-être ici"
				underline
				rotate={-3}
				class="join-hero__note"
			/>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="perks">
				<div class="perks__col">
					{
						atoutsGauche.map((atout, i) => {
							const fil = filDe(i, atoutsGauche.length);
							return (
								<article
									class:list={['card', 'perk', 'perk--start', fil.remonte && 'perk--fil-remonte']}
								>
									<Image
										src={atout.illus}
										alt=""
										widths={[120]}
										sizes="52px"
										format="webp"
										class="illus"
									/>
									<div>
										<h3>{atout.name}</h3>
										<p class="muted">{atout.description}</p>
									</div>
									<svg class="perk__fil" viewBox="0 0 76 30" aria-hidden="true">
										<path d={fil.d} />
										<circle cx="6" cy="6" r="6" />
									</svg>
								</article>
							);
						})
					}
				</div>

				<div class="perks__center">
					<Image
						src={mascotte}
						alt=""
						widths={[280, 480, 700]}
						sizes="(max-width: 1000px) 50vw, 260px"
						format="webp"
						loading="eager"
						class="blend-white"
					/>
					<a href={mailtoCandidature} class="btn btn--plum">
						Envoyer une candidature <span class="btn__arrow" aria-hidden="true">→</span>
					</a>
				</div>

				<div class="perks__col">
					{
						atoutsDroite.map((atout, i) => {
							const fil = filDe(i, atoutsDroite.length);
							return (
								<article
									class:list={['card', 'perk', 'perk--end', fil.remonte && 'perk--fil-remonte']}
								>
									<Image
										src={atout.illus}
										alt=""
										widths={[120]}
										sizes="52px"
										format="webp"
										class="illus"
									/>
									<div>
										<h3>{atout.name}</h3>
										<p class="muted">{atout.description}</p>
									</div>
									<svg class="perk__fil" viewBox="0 0 76 30" aria-hidden="true">
										<path d={fil.d} />
										<circle cx="6" cy="6" r="6" />
									</svg>
								</article>
							);
						})
					}
				</div>
			</div>
		</div>
	</section>


	<section class="section" id="candidater">
		<div class="container">
			<div class="apply">
				<h2>Postuler chez Blueberry</h2>
				<p class="apply__note">
					Chaque recrutement naît d’un besoin précis, au fil de nos projets. Présentez-nous votre
					profil et ce que vous recherchez, CV ou LinkedIn à l’appui, nous étudions chaque
					candidature avec attention.
				</p>
				<div class="apply__actions">
					<a href={mailtoCandidature} class="btn btn--primary">
						Écrire à {company.email}
					</a>
					<a href={company.whatsapp} class="btn btn--ghost" target="_blank" rel="noopener">
						Nous joindre sur WhatsApp
					</a>
					<a href={company.linkedin} class="btn btn--ghost" target="_blank" rel="noopener">
						Nous suivre sur LinkedIn
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.join-hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(1.5rem, 1.1rem + 2vw, 2.5rem) clamp(0.6rem, 0.5rem + 0.6vw, 1rem);
	}

	.join-hero__inner {
		display: grid;
		gap: 0.75rem;
	}

	.join-hero .lead {
		max-width: 56ch;
	}

	.join-hero :global(.join-hero__note) {
		max-width: 24ch;
	}

	@media (min-width: 900px) {
		.join-hero__inner {
			grid-template-columns: 1.55fr 0.45fr;
			align-items: start;
			gap: 2rem;
		}

		.join-hero :global(.join-hero__note) {
			margin-top: 0.75rem;
		}
	}

	/* ---------- Atouts en étoile autour de la mascotte ---------- */

	.perks {
		display: grid;
		gap: 0.8rem;
	}

	.perks__col {
		display: grid;
		gap: 0.8rem;
		align-content: center;
	}

	.perks__center {
		order: -1;
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 0.9rem;
	}

	.perks__center img {
		width: min(50vw, 210px);
		height: auto;
	}

	.perk {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		/* Cartes resserrées : la page respirait trop pour la densité voulue. */
		padding: 1.05rem;
	}

	.perk h3 {
		margin-bottom: 0.2rem;
	}

	.perk :global(.illus) {
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		/* Les pictos « atout » sont carrés, celui de l'ambiance non : sans
		   `contain` le carré imposé l'écraserait. Le fond quasi blanc des
		   sources se confond avec celui de la carte, le cadrage ne se voit pas. */
		object-fit: contain;
		margin-bottom: 0;
	}

	.perk p {
		margin-bottom: 0;
	}

	/* En colonne unique, les cartes ne sont plus disposées autour de la
	   mascotte : les fils n'ont plus rien à relier. */
	.perk__fil {
		display: none;
	}

	@media (min-width: 1000px) {
		.perks {
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: 1.6rem;
		}

		.perks__center {
			order: 0;
		}

		.perks__center img {
			width: 260px;
		}

		/* Chaque carte tire un fil vers la mascotte. Le point est posé à cheval
		   sur le bord intérieur, à hauteur de la première ligne du titre
		   (1,05rem de padding + la moitié de son interligne), et non au milieu
		   de la carte. */
		.perk {
			position: relative;
		}

		.perk__fil {
			display: block;
			position: absolute;
			inset-block-start: calc(1.8rem - 6px);
			width: 76px;
			height: 30px;
			/* Le retournement pivote sur le point lui-même : il reste collé au
			   bord de la carte quel que soit le sens du fil. */
			transform: scale(var(--fil-x, 1), var(--fil-y, 1));
			transform-origin: 6px 6px;
			/* Sur la maquette le fil disparaît derrière la mascotte ; ici elle
			   n'a pas de fond opaque, d'où ce fondu juste avant elle. */
			-webkit-mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
			mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
		}

		.perk__fil path {
			fill: none;
			stroke: var(--bb-border-strong);
			stroke-width: 2;
		}

		.perk__fil circle {
			fill: var(--bb-violet);
		}

		/* Dernière carte d'une colonne : son fil remonte vers le centre. Le sens
		   est décidé au rendu, la colonne de gauche en comptant trois. */
		.perk--fil-remonte {
			--fil-y: -1;
		}

		/* Points violet et orange en alternance, comme sur la maquette. */
		.perks__col .perk:nth-child(even) .perk__fil circle {
			fill: var(--bb-orange);
		}

		.perk--start .perk__fil {
			inset-inline-start: calc(100% - 6px);
		}

		.perk--end .perk__fil {
			--fil-x: -1;
			inset-inline-start: -6px;
		}
	}

	/* ---------- Candidature ---------- */

	/* Les deux sections empilent leur respiration : celle des atouts suffit à
	   détacher le bloc candidature. */
	#candidater {
		padding-block-start: 0;
	}

	.apply {
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius-lg);
		background: #fff;
		box-shadow: var(--bb-shadow);
		padding: clamp(1.35rem, 1rem + 1.4vw, 2rem);
		text-align: center;
	}

	.apply__note {
		max-width: 60ch;
		margin-inline: auto;
		color: var(--bb-muted);
	}

	.apply__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		justify-content: center;
		margin-top: 1.1rem;
	}

	.apply__actions .btn {
		max-width: 100%;
		overflow-wrap: anywhere;
	}
</style>
