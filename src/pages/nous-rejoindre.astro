---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Scribble from '../components/Scribble.astro';
import OfficeVideo from '../components/OfficeVideo.astro';
import mascotte from '../assets/brand/mascotte.png';
import illusRemuneration from '../assets/illus/atout-remuneration.png';
import illusCompetences from '../assets/illus/atout-competences.png';
import illusProjets from '../assets/illus/atout-projets.png';
import illusSophia from '../assets/illus/atout-sophia.png';
import { company } from '../data/company';

const atouts = [
	{
		illus: illusRemuneration,
		name: 'Rémunération au-dessus du marché',
		description:
			'Les meilleurs talents méritent les meilleures récompenses. Nous assumons une politique salariale supérieure aux taux du marché.',
	},
	{
		illus: illusCompetences,
		name: 'Montée en compétences',
		description:
			'Un accompagnement dans la durée pour faire grandir votre expertise, pas seulement pour remplir une mission.',
	},
	{
		illus: illusProjets,
		name: 'Des projets qui comptent',
		description:
			'Automobile, aérien, défense, espace, télécommunications : des sujets techniques exigeants, pour des clients qui ne se contentent pas d’à-peu-près.',
	},
	{
		illus: illusSophia,
		name: 'Sophia-Antipolis',
		description:
			'La première technopole d’Europe, entre mer et arrière-pays. Le cadre de travail compte autant que le poste.',
	},
];

const objet = encodeURIComponent('Candidature spontanée');
const corps = encodeURIComponent(
	"Bonjour,\n\nJe vous écris pour une candidature spontanée.\n\nPoste recherché :\nDisponibilité :\n\n(Pensez à joindre votre CV à ce message.)\n\nCordialement,"
);
---

<BaseLayout
	title="Nous rejoindre"
	description="Vous cherchez un nouveau défi professionnel et une rémunération au-dessus du prix du marché ? Blueberry Digital Services recrute à Sophia-Antipolis."
>
	<section class="join-hero">
		<div class="container join-hero__inner">
			<div class="join-hero__text">
				<p class="eyebrow">Rejoignez l’aventure</p>
				<h1>Bien plus qu’un job,<br /><span class="accent-word">un véritable tremplin</span></h1>
				<p class="lead">
					Nous croyons que chaque personne apporte une valeur unique à notre équipe. Notre ambition
					est de vous offrir une expérience professionnelle stimulante et épanouissante.
				</p>
			</div>

			<Scribble
				text="Des talents d’aujourd’hui pour les défis de demain"
				underline
				rotate={-3}
				class="join-hero__note"
			/>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="perks">
				<div class="perks__col">
					{
						atouts.slice(0, 2).map((atout) => (
							<article class="card perk perk--start">
								<Image
									src={atout.illus}
									alt=""
									widths={[120]}
									sizes="60px"
									format="webp"
									class="illus"
								/>
								<div>
									<h3>{atout.name}</h3>
									<p class="muted">{atout.description}</p>
								</div>
							</article>
						))
					}
				</div>

				<div class="perks__center">
					<Image
						src={mascotte}
						alt=""
						widths={[280, 480, 700]}
						sizes="(max-width: 1000px) 58vw, 320px"
						format="webp"
						loading="eager"
						class="blend-white"
					/>
				</div>

				<div class="perks__col">
					{
						atouts.slice(2).map((atout) => (
							<article class="card perk perk--end">
								<Image
									src={atout.illus}
									alt=""
									widths={[120]}
									sizes="60px"
									format="webp"
									class="illus"
								/>
								<div>
									<h3>{atout.name}</h3>
									<p class="muted">{atout.description}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>

			<div class="perks__footer">
				<Scribble text="Tech talents, positive impact" rotate={-4} class="perks__note perks__note--start" />
				<a href="#candidater" class="btn btn--plum">
					Envoyer une candidature <span class="btn__arrow" aria-hidden="true">→</span>
				</a>
				<Scribble
					text="Rejoignez une équipe qui avance"
					tone="orange"
					rotate={4}
					class="perks__note perks__note--end"
				/>
			</div>
		</div>
	</section>

	<section class="section section--soft">
		<div class="container env">
			<div class="prose">
				<p class="eyebrow">Notre environnement</p>
				<h2>Le bien-être génère la performance</h2>
				<p>
					Nous croyons que l’avenir de l’entreprise est ouvert et collaboratif. Concrètement : une
					structure à taille humaine où l’on connaît tout le monde, des décisions qui ne mettent pas
					six mois à être prises, et une direction accessible.
				</p>
				<p>
					Le reste se raconte mieux en images : sorties en bateau, journées au ski, Jeux de
					Sophia… <a href="/actus">la vie de l’équipe est sur la page actu</a>.
				</p>
			</div>

			<OfficeVideo />
		</div>
	</section>

	<section class="section" id="candidater">
		<div class="container">
			<div class="apply">
				<h2>Postuler chez Blueberry</h2>
				<p class="apply__note">
					Nous n’avons pas de liste d’offres en ligne : nos besoins évoluent au rythme de nos projets
					et nous préférons étudier chaque profil individuellement. Écrivez-nous en nous disant ce que
					vous cherchez, et joignez votre CV.
				</p>
				<div class="apply__actions">
					<a href={`mailto:${company.email}?subject=${objet}&body=${corps}`} class="btn btn--primary">
						Écrire à {company.email}
					</a>
					<a href={company.whatsapp} class="btn btn--ghost" target="_blank" rel="noopener">
						Nous joindre sur WhatsApp
					</a>
					<a href={company.linkedin} class="btn btn--ghost" target="_blank" rel="noopener">
						Nous suivre sur LinkedIn
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.join-hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2.25rem, 1.6rem + 3.5vw, 4rem) clamp(1rem, 0.8rem + 1vw, 1.5rem);
	}

	.join-hero__inner {
		display: grid;
		gap: 1.25rem;
	}

	.join-hero .lead {
		max-width: 56ch;
	}

	.join-hero :global(.join-hero__note) {
		max-width: 24ch;
	}

	@media (min-width: 900px) {
		.join-hero__inner {
			grid-template-columns: 1.55fr 0.45fr;
			align-items: start;
			gap: 2rem;
		}

		.join-hero :global(.join-hero__note) {
			margin-top: 1.5rem;
		}
	}

	/* ---------- Atouts en étoile autour de la mascotte ---------- */

	.perks {
		display: grid;
		gap: 1.1rem;
	}

	.perks__col {
		display: grid;
		gap: 1.1rem;
		align-content: center;
	}

	.perks__center {
		order: -1;
		display: grid;
		justify-items: center;
	}

	.perks__center img {
		width: min(58vw, 250px);
		height: auto;
	}

	.perk {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.perk :global(.illus) {
		flex-shrink: 0;
		width: 60px;
		height: 60px;
		margin-bottom: 0;
	}

	.perk p {
		margin-bottom: 0;
	}

	@media (min-width: 1000px) {
		.perks {
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: 2.5rem;
		}

		.perks__center {
			order: 0;
		}

		.perks__center img {
			width: 300px;
		}

		/* Chaque carte tire un fil vers la mascotte : le point est sur le bord
		   intérieur, le trait traverse la gouttière de la grille. */
		.perk {
			position: relative;
		}

		.perk::before,
		.perk::after {
			content: '';
			position: absolute;
			inset-block-start: 50%;
			transform: translateY(-50%);
		}

		.perk::after {
			width: 2.5rem;
			height: 2px;
		}

		.perk::before {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: var(--bb-orange);
			box-shadow: 0 0 0 4px rgb(242 107 33 / 14%);
			z-index: 1;
		}

		.perk--start::after {
			inset-inline-start: 100%;
			background: linear-gradient(90deg, var(--bb-plum-500), transparent);
		}

		.perk--start::before {
			inset-inline-start: calc(100% - 5px);
		}

		.perk--end::after {
			inset-inline-end: 100%;
			background: linear-gradient(270deg, var(--bb-plum-500), transparent);
		}

		.perk--end::before {
			inset-inline-end: calc(100% - 5px);
		}
	}

	.perks__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.25rem 2rem;
		margin-top: 2.5rem;
	}

	.perks__footer :global(.perks__note) {
		max-width: 16ch;
	}

	/* Les deux notes n'apparaissent que lorsqu'il y a la place de les poser
	   de part et d'autre du bouton, sinon elles encombrent le mobile. */
	.perks__footer :global(.perks__note) {
		display: none;
	}

	@media (min-width: 800px) {
		.perks__footer :global(.perks__note) {
			display: inline-block;
		}
	}

	/* ---------- Environnement ---------- */

	.env {
		display: grid;
		gap: 1.75rem;
		align-items: center;
	}

	.env .prose {
		max-width: 60ch;
	}

	@media (min-width: 900px) {
		.env {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}
	}

	/* ---------- Candidature ---------- */

	.apply {
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius-lg);
		background: #fff;
		box-shadow: var(--bb-shadow);
		padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
		text-align: center;
	}

	.apply__note {
		max-width: 60ch;
		margin-inline: auto;
		color: var(--bb-muted);
	}

	.apply__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		justify-content: center;
		margin-top: 1.5rem;
	}

	.apply__actions .btn {
		max-width: 100%;
		overflow-wrap: anywhere;
	}
</style>
