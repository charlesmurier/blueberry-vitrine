---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Scribble from '../components/Scribble.astro';
import { company, mapsUrl } from '../data/company';

const moyens = [
	{
		icon: 'mail',
		label: 'Email',
		value: company.email,
		href: `mailto:${company.email}`,
		hint: 'La voie la plus sûre pour un projet ou une candidature.',
		external: false,
	},
	{
		icon: 'phone',
		label: 'Téléphone',
		value: company.phoneDisplay,
		href: company.phoneLink,
		hint: 'Du lundi au vendredi, aux heures de bureau.',
		external: false,
	},
	{
		icon: 'chat',
		label: 'WhatsApp',
		value: 'Démarrer une discussion',
		href: company.whatsapp,
		hint: 'Pour un échange rapide, sans formalité.',
		external: true,
	},
	{
		icon: 'linkedin',
		label: 'LinkedIn',
		value: 'Blueberry Digital Services',
		href: company.linkedin,
		hint: 'Nos actualités et nos publications.',
		external: true,
	},
];
---

<BaseLayout
	title="Contact"
	description="Contactez Blueberry Digital Services à Mougins, Sophia-Antipolis : par email, téléphone, WhatsApp ou LinkedIn."
>
	<section class="page-head">
		<div class="container page-head__inner">
			<div>
				<p class="eyebrow">Contact</p>
				<h1>Parlons de votre <span class="accent-word">projet</span></h1>
				<p class="lead">
					Une question, un besoin d’accompagnement, une candidature ? Écrivez-nous, nous répondons
					rapidement.
				</p>
			</div>
			<Scribble text="On répond vite, promis !" sparks rotate={-4} class="page-head__note" />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="grid grid--2">
				{
					moyens.map((moyen) => (
						<a
							class="contact-card"
							href={moyen.href}
							target={moyen.external ? '_blank' : undefined}
							rel={moyen.external ? 'noopener' : undefined}
						>
							<span class="icon-tile">
								<Icon name={moyen.icon} />
							</span>
							<span class="contact-card__label">{moyen.label}</span>
							<span class="contact-card__value">{moyen.value}</span>
							<span class="contact-card__hint">{moyen.hint}</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--soft">
		<div class="container split">
			<div>
				<p class="eyebrow">Nos bureaux</p>
				<h2>Mougins, Sophia-Antipolis</h2>
				<address>
					{company.address.line1}<br />
					{company.address.line2}<br />
					{`${company.address.postcode} ${company.address.city}`}<br />
					{company.address.country}
				</address>
				<a href={mapsUrl} class="btn btn--plum" target="_blank" rel="noopener">
					Ouvrir dans Google Maps
				</a>
			</div>

			<aside class="card recruit-note">
				<h3>Vous postulez ?</h3>
				<p class="muted">
					Nous n’avons pas de liste d’offres en ligne. Envoyez-nous votre CV en précisant ce que vous
					recherchez : chaque candidature est étudiée individuellement.
				</p>
				<a href="/nous-rejoindre" class="btn btn--ghost">Voir la page Nous rejoindre</a>
			</aside>
		</div>
	</section>
</BaseLayout>

<style>
	.page-head {
		padding-block: clamp(2rem, 1.6rem + 2.5vw, 3.5rem) clamp(1.25rem, 1rem + 1.5vw, 2rem);
	}

	.page-head__inner {
		display: grid;
		gap: 1rem;
		align-items: center;
	}

	.page-head .lead {
		max-width: 58ch;
	}

	.page-head :global(.page-head__note) {
		max-width: 18ch;
	}

	@media (min-width: 900px) {
		.page-head__inner {
			grid-template-columns: 1.5fr 0.5fr;
			gap: 2rem;
		}
	}

	.contact-card {
		display: block;
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius);
		padding: 1.25rem;
		box-shadow: var(--bb-shadow);
		text-decoration: none;
		color: inherit;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.contact-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--bb-shadow-lift);
		border-color: var(--bb-plum-500);
	}

	.contact-card__label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bb-muted);
		margin-bottom: 0.3rem;
	}

	.contact-card__value {
		display: block;
		font-family: var(--bb-font-head);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--bb-plum-900);
		overflow-wrap: anywhere;
	}

	.contact-card__hint {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: var(--bb-muted);
	}

	.split {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1.3fr 1fr;
			gap: 2.25rem;
			align-items: start;
		}
	}

	address {
		font-style: normal;
		line-height: 1.7;
		margin-bottom: 1.25rem;
		color: var(--bb-ink);
	}

	.recruit-note h3 {
		margin-bottom: 0.5rem;
	}

	.recruit-note .btn {
		margin-top: 0.5rem;
	}

	.muted {
		color: var(--bb-muted);
		font-size: 0.95rem;
	}
</style>
