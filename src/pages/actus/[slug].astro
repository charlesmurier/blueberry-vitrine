---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const actus = await getCollection('actus');
	return actus.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, excerpt, cover, coverAlt, gallery } = entry.data;

const dateLabel = date.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<BaseLayout title={title} description={excerpt}>
	<article class="actu">
		<header class="actu__head">
			<div class="container actu__head-inner">
				<a href="/actus" class="actu__back">← Toutes les actus</a>
				<h1>{title}</h1>
				<time datetime={date.toISOString()}>{dateLabel}</time>
			</div>
		</header>

		{
			cover && (
				<div class="container">
					<figure class="actu__cover">
						<Image
							src={cover}
							alt={coverAlt ?? ''}
							widths={[480, 800, 1280]}
							sizes="(max-width: 680px) 100vw, 640px"
							format="webp"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				</div>
			)
		}

		<div class="container">
			<div class="prose actu__body">
				<Content />
			</div>
		</div>

		{
			gallery && gallery.length > 0 && (
				<div class="container">
					<section class="actu__gallery" aria-label="Galerie photos">
						<h2>En images</h2>
						<div class="gallery-grid">
							{gallery.map((photo) => (
								<figure>
									<Image
										src={photo.src}
										alt={photo.caption ?? ''}
										widths={[320, 640]}
										sizes="(max-width: 620px) 100vw, 300px"
										format="webp"
										loading="lazy"
									/>
									{photo.caption && <figcaption>{photo.caption}</figcaption>}
								</figure>
							))}
						</div>
					</section>
				</div>
			)
		}

		<div class="container actu__footer">
			<a href="/actus" class="btn btn--ghost">← Toutes les actus</a>
		</div>
	</article>
</BaseLayout>

<style>
	/* Toute la page article tient dans une seule colonne centrée : titre,
	   couverture et texte partagent la même largeur et les mêmes bords. */
	.actu {
		--actu-col: 640px;
	}

	.actu__head {
		padding-block: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem) clamp(1rem, 0.85rem + 1vw, 1.5rem);
	}

	.actu__head-inner {
		max-width: var(--actu-col);
		margin-inline: auto;
	}

	.actu__back {
		display: inline-block;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		margin-bottom: 1rem;
	}

	.actu__head time {
		color: var(--bb-muted);
		font-size: 0.93rem;
	}

	.actu__cover {
		max-width: var(--actu-col);
		margin: 0 auto 1.75rem;
		border-radius: var(--bb-radius-lg);
		overflow: hidden;
		box-shadow: var(--bb-shadow);
	}

	.actu__cover img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		display: block;
	}

	.actu__body {
		max-width: var(--actu-col);
		margin-inline: auto;
		font-size: 1rem;
	}

	/* La galerie déborde un peu de la colonne de texte : des vignettes à
	   640px de large seraient trop petites pour être lisibles. */
	.actu__gallery {
		max-width: 920px;
		margin: 2.25rem auto 0;
	}

	.actu__gallery h2 {
		font-size: 1.2rem;
		margin-bottom: 1rem;
	}

	.gallery-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 620px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.gallery-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.gallery-grid figure {
		margin: 0;
	}

	.gallery-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--bb-radius);
		display: block;
	}

	.gallery-grid figcaption {
		margin-top: 0.5rem;
		font-size: 0.86rem;
		color: var(--bb-muted);
	}

	/* Celui-ci porte aussi .container : sa largeur inclut les gouttières,
	   qu'il faut rajouter pour que son bord gauche tombe sur le texte. */
	.actu__footer {
		max-width: calc(var(--actu-col) + var(--bb-gutter) * 2);
		margin: 2.25rem auto 0;
	}
</style>
