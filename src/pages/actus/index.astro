---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActuCard from '../../components/ActuCard.astro';
import Scribble from '../../components/Scribble.astro';
import photographe from '../../assets/illus/actu-photographe.png';

const actus = (await getCollection('actus')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
	title="L'actu"
	description="Sorties, événements et vie d'entreprise chez Blueberry Digital Services."
>
	<section class="page-head">
		<div class="container page-head__inner">
			<div>
				<h1>La vie chez <span class="accent-word">Blueberry</span></h1>
				<p class="lead">
					Sorties en bateau, journées au ski, Jeux de Sophia… Ce qui se passe chez nous quand on ne
					code pas. Ces moments partagés en dehors des projets, c’est aussi ça, Blueberry :
					l’occasion de se retrouver et de passer du temps ensemble autrement.
				</p>
			</div>

			<div class="page-head__visual">
				<Image
					src={photographe}
					alt=""
					widths={[560, 1120]}
					sizes="(max-width: 900px) 92vw, 560px"
					format="webp"
					loading="eager"
				/>
				{/* La coupe est écrite dans le texte : les étincelles se posent aux
				    bords de la boîte, qui doit donc coller à la plus longue ligne.
				    Espace fine insécable avant le « ! », sinon il part seul sur sa
				    ligne. L'inclinaison est posée en CSS : elle change avec la
				    mise en page. */}
				<Scribble text={'Good vibes\nseulement !'} sparks class="page-head__note" />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				actus.length > 0 ? (
					<>
						<div class="toolbar" data-actus-toolbar hidden>
							<div class="search">
								<label class="visually-hidden" for="recherche-actu">
									Rechercher un article
								</label>
								<svg class="search__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<circle
										cx="11"
										cy="11"
										r="6.4"
										stroke="currentColor"
										stroke-width="1.8"
									/>
									<path
										d="m16 16 4 4"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
									/>
								</svg>
								<input
									type="search"
									id="recherche-actu"
									placeholder="Rechercher un article…"
									autocomplete="off"
									data-search
								/>
							</div>
						</div>

						<p class="visually-hidden" role="status" data-actus-status />

						<div class="grid grid--3">
							{actus.map((entry, i) => (
								<ActuCard entry={entry} eager={i === 0} />
							))}
						</div>

						<p class="empty" data-actus-empty hidden>
							Aucun article ne correspond à cette recherche.
						</p>

						<Scribble
							text="Des moments qu’on aime partager"
							sparks
							rotate={3}
							class="actus-outro"
						/>
					</>
				) : (
					<p class="empty">Les premières actualités arrivent bientôt.</p>
				)
			}
		</div>
	</section>
</BaseLayout>

<script>
	const toolbar = document.querySelector<HTMLElement>('[data-actus-toolbar]');

	if (toolbar) {
		// La barre n'apparaît qu'une fois le script en place : sans JS, mieux vaut
		// aucune recherche qu'un champ qui ne répond pas.
		toolbar.hidden = false;

		const cartes = Array.from(document.querySelectorAll<HTMLElement>('[data-actu]'));
		const champ = toolbar.querySelector<HTMLInputElement>('[data-search]');
		const etat = document.querySelector<HTMLElement>('[data-actus-status]');
		const vide = document.querySelector<HTMLElement>('[data-actus-empty]');

		const sansAccent = (valeur: string) =>
			valeur
				.toLowerCase()
				.normalize('NFD')
				.replace(/\p{Diacritic}/gu, '')
				.trim();

		const appliquer = () => {
			const requete = sansAccent(champ?.value ?? '');
			let visibles = 0;

			for (const carte of cartes) {
				const afficher = !requete || (carte.dataset.haystack ?? '').includes(requete);

				carte.hidden = !afficher;
				if (afficher) visibles += 1;
			}

			if (vide) vide.hidden = visibles > 0;
			if (etat) {
				etat.textContent =
					visibles === 0
						? 'Aucun article ne correspond à cette recherche.'
						: `${visibles} article${visibles > 1 ? 's' : ''} affiché${visibles > 1 ? 's' : ''}.`;
			}
		};

		champ?.addEventListener('input', appliquer);
		appliquer();
	}
</script>

<style>
	.page-head {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2rem, 1.6rem + 2.5vw, 3.5rem) 0.5rem;
	}

	/* Le texte d'intro et la barre de recherche qui suit forment un seul bloc :
	   la respiration par défaut entre deux sections les écartait trop. */
	.page-head + .section {
		padding-block-start: 0.75rem;
	}

	.page-head__inner {
		display: grid;
		gap: 1.25rem;
		align-items: center;
	}

	.page-head .lead {
		max-width: 52ch;
	}

	.page-head__visual {
		/* Sur mobile l'image passe avant le texte dans la mise en page ; à
		   partir de 900px elle repasse dans l'ordre du DOM, à droite. */
		order: -1;
		position: relative;
		display: grid;
		justify-items: center;
	}

	/* Illustration très large (ratio 2,05) : il lui faut plus de largeur qu'au
	   visuel de l'accueil pour atteindre la même hauteur rendue. */
	.page-head__visual img {
		width: min(92vw, 460px);
		height: auto;
	}

	.page-head__visual :global(.page-head__note) {
		position: absolute;
		margin: 0;
		/* Les étincelles se posent aux coins hauts de la boîte, donc de part et
		   d'autre de la première ligne : la boîte se règle sur la plus longue
		   ligne (coupe écrite dans le texte) et les lignes sont centrées, sinon
		   l'une des deux étincelles se retrouve à distance du texte. */
		white-space: pre-line;
		width: max-content;
		text-align: center;
	}

	/* La note se pose en biais dans le coin haut droit de l'illustration, où
	   elle mord sur le vide du PNG. Le relevé de la couche alpha borne ce vide :
	   la pointe de la feuille pêche monte jusqu'à 8 % de la hauteur, et rien
	   n'est opaque au-delà de 77 % de la largeur avant 28 % de la hauteur. La
	   note passe au-dessus de la feuille *et* à sa droite : deux marges plutôt
	   qu'une si les métriques bougent. Elle est plus petite qu'au fil du texte,
	   sans quoi ni elle ni ses étincelles n'entrent dans ce coin. */
	@media (max-width: 899px) {
		/* La colonne se règle sur l'illustration, sinon la note se calerait sur
		   son bord à elle : passé 460px l'image ne remplit plus la largeur
		   disponible et la note partirait flotter à côté. */
		.page-head__visual {
			justify-self: center;
		}

		.page-head__visual :global(.page-head__note) {
			/* Le coin libre se resserre avec l'illustration, qui suit la largeur
			   de l'écran : à taille fixe, la note finissait par toucher la
			   feuille sur les petits téléphones. */
			font-size: clamp(0.85rem, 4.6vw - 0.15rem, 1.1rem);
			inset-block-start: -0.5em;
			/* Décalée du bord pour que l'étincelle de fin, qui sort de la boîte
			   d'environ 1,35 em, ne vienne pas coller au bord de l'écran. */
			inset-inline-end: 0.9em;
			/* Penchée dans l'autre sens, la seconde ligne descendrait sur la
			   feuille et le panneau ; ici elle remonte vers la gauche. */
			transform: rotate(5deg);
		}
	}

	@media (min-width: 900px) {
		.page-head__inner {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}

		.page-head__visual {
			order: 0;
			/* Bande réservée à la note : sans elle, son étincelle de fin, qui
			   déborde la boîte d'environ 1,35 em, tombe sur le personnage. */
			padding-inline-start: 2.5rem;
		}

		.page-head__visual img {
			width: 100%;
			max-width: 560px;
		}

		/* La colonne est assez large pour loger la note à gauche du personnage,
		   sans mordre sur l'illustration. */
		.page-head__visual :global(.page-head__note) {
			inset-block-start: 0.5rem;
			inset-inline: -1rem auto;
			transform: rotate(-5deg);
		}
	}

	/* ---------- Recherche ---------- */

	.toolbar {
		display: flex;
		justify-content: flex-start;
		margin-bottom: 2rem;
	}

	.search {
		position: relative;
		flex: 1 1 240px;
		max-width: 340px;
	}

	.search__icon {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 0.95rem;
		width: 18px;
		height: 18px;
		transform: translateY(-50%);
		color: var(--bb-muted);
		pointer-events: none;
	}

	.search input {
		width: 100%;
		font-family: var(--bb-font-body);
		font-size: 0.93rem;
		color: var(--bb-ink);
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: 999px;
		padding: 0.7rem 1.1rem 0.7rem 2.75rem;
	}

	.search input::placeholder {
		color: var(--bb-muted);
	}

	.search input:focus-visible {
		border-color: var(--bb-plum-500);
	}

	/* ---------- Liste ---------- */

	.grid :global(.actu-card[hidden]) {
		display: none;
	}

	.empty {
		color: var(--bb-muted);
	}

	.section :global(.actus-outro) {
		display: block;
		margin: 2.5rem auto 0;
		max-width: 22ch;
		text-align: center;
	}
</style>
