---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorCard from '../components/SectorCard.astro';
import ActuCard from '../components/ActuCard.astro';
import CTABanner from '../components/CTABanner.astro';
import Scribble from '../components/Scribble.astro';
import Icon from '../components/Icon.astro';
import heroBureau from '../assets/illus/hero-bureau.png';
import valeurRespect from '../assets/illus/valeur-respect.png';
import valeurIntegrite from '../assets/illus/valeur-integrite.png';
import valeurSolidarite from '../assets/illus/valeur-solidarite.png';
import { sectors, sectorsLabel } from '../data/company';

const dernieresActus = (await getCollection('actus'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const valeurs = [
	{
		illus: valeurRespect,
		name: 'Respect',
		description:
			'Chaque personne apporte une valeur unique à l’équipe, bien au-delà de son rôle professionnel.',
	},
	{
		illus: valeurIntegrite,
		name: 'Intégrité',
		description:
			'Des engagements tenus, une parole claire avec nos clients comme avec nos collaborateurs.',
	},
	{
		illus: valeurSolidarite,
		name: 'Solidarité',
		description:
			'On avance ensemble. Les réussites comme les difficultés d’un projet se partagent.',
	},
];

const enBref = [
	{ icon: 'briefcase', label: 'En bref', value: 'Conseil en informatique et numérique' },
	{ icon: 'pin', label: 'Implantation', value: 'Mougins, Sophia-Antipolis (06)' },
	{ icon: 'sectors', label: 'Secteurs', value: sectorsLabel },
	{ icon: 'star', label: 'Ce qui nous distingue', value: 'Le bien-être génère la performance' },
];
---

<BaseLayout
	title="Conseil en informatique et numérique à Sophia-Antipolis"
	description="Blueberry Digital Services accompagne les projets technologiques exigeants dans l'automobile, l'aérien, la défense, l'espace et les télécommunications. Chez nous, l'humain passe avant tout."
>
	<section class="hero">
		<div class="decor" aria-hidden="true">
			<span class="blob blob--soft hero__blob hero__blob--bas"></span>
		</div>
		<div class="container hero__inner">
			<div class="hero__text">
				<h1>Une aventure <span class="accent-word">humaine</span></h1>
				<p class="lead">
					Blueberry Digital Services accompagne ses clients sur des projets technologiques exigeants.
					Notre conviction est simple : le bien-être génère la performance, et l’humain passe avant
					tout.
				</p>
				<div class="hero__actions">
					<a href="/nous-rejoindre" class="btn btn--plum">
						Nous rejoindre <span class="btn__arrow" aria-hidden="true">→</span>
					</a>
					<a href="#secteurs" class="btn btn--ghost">Nos secteurs</a>
				</div>
			</div>

			{/* Les pastilles Tech/Humain/Impact et la note manuscrite font partie
			    de l'illustration de la charte : elles sont dans l'image. */}
			<Image
				src={heroBureau}
				alt=""
				widths={[498]}
				sizes="(max-width: 900px) 92vw, 520px"
				format="webp"
				loading="eager"
				fetchpriority="high"
				class="hero__illus"
			/>
		</div>
	</section>

	<section class="section histoire">
		<div class="decor" aria-hidden="true">
			<span class="blob histoire__blob"></span>
		</div>
		<div class="container split">
			<div class="prose">
				<h2>Notre histoire</h2>
				<p>
					Depuis sa création, Blueberry Digital Services a adopté une approche singulière dans un
					secteur qui l’est rarement : considérer que la performance d’un projet informatique tient
					d’abord à celles et ceux qui le portent.
				</p>
				<p>
					Nous considérons que chaque projet est avant tout une aventure humaine, où l’expérience et
					les compétences de chaque individu sont essentielles pour réussir. C’est ce qui guide notre
					manière de recruter, d’accompagner nos consultants et de travailler avec nos clients.
				</p>
				<a href="/notre-histoire" class="btn btn--ghost histoire__lien">
					Découvrir notre histoire <span class="btn__arrow" aria-hidden="true">→</span>
				</a>
			</div>

			<aside class="facts">
				<h2 class="visually-hidden">En bref</h2>
				<dl>
					{
						enBref.map((fait) => (
							<div class="facts__row">
								<span class="icon-tile icon-tile--sm">
									<Icon name={fait.icon} />
								</span>
								<div>
									<dt>{fait.label}</dt>
									<dd>{fait.value}</dd>
								</div>
							</div>
						))
					}
				</dl>
			</aside>
		</div>
	</section>

	<section class="section valeurs">
		<div class="decor" aria-hidden="true">
			<span class="blob valeurs__blob valeurs__blob--droite"></span>
			<span class="blob blob--soft valeurs__blob valeurs__blob--gauche"></span>
		</div>
		<div class="container">
			<div class="section__intro">
				<h2>Nos valeurs</h2>
			</div>

			<div class="values">
				<div class="grid grid--3">
					{
						valeurs.map((valeur) => (
							<article class="card card--lift">
								<Image
									src={valeur.illus}
									alt=""
									widths={[176]}
									sizes="88px"
									format="webp"
									class="illus valeurs__illus"
								/>
								<h3>{valeur.name}</h3>
								<p class="muted">{valeur.description}</p>
							</article>
						))
					}
				</div>
				<Scribble text="Des valeurs qui nous font grandir" rotate={-8} class="values__note" />
			</div>
		</div>
	</section>

	<section class="section" id="secteurs">
		<div class="container">
			<div class="section__intro">
				<h2>Nos secteurs d’activité</h2>
				<p class="lead">
					Une approche multi-spécialiste qui nous permet de proposer des services à forte valeur
					ajoutée dans des domaines où la qualité, la robustesse et la sécurité ne sont pas
					négociables.
				</p>
			</div>

			<div class="grid grid--5">
				{sectors.map((sector) => <SectorCard {...sector} />)}
			</div>
		</div>
	</section>

	{
		dernieresActus.length > 0 && (
			<section class="section section--soft">
				<div class="container">
					<div class="actus-head">
						<div class="section__intro">
							<h2>La vie de l’équipe</h2>
							<p class="lead">
								Sorties, événements, moments partagés : ce qui se passe chez nous quand on ne code
								pas.
							</p>
						</div>
						<a href="/actus" class="btn btn--ghost actus-head__link">
							Toutes les actus <span class="btn__arrow" aria-hidden="true">→</span>
						</a>
					</div>

					<div class="grid grid--3">
						{dernieresActus.map((entry, i) => (
							<ActuCard entry={entry} eager={i === 0} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CTABanner
		title="Envie de rejoindre l’aventure ?"
		text="Des projets ambitieux, une équipe soudée et un cadre de vie unique en plein cœur de la Côte d’Azur."
		ctaLabel="Nous rejoindre"
		ctaHref="/nous-rejoindre"
	/>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding-block: clamp(1.25rem, 0.9rem + 2vw, 2.5rem);
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		gap: 1rem;
		align-items: center;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.hero :global(.hero__illus) {
		order: -1;
		width: min(92vw, 420px);
		height: auto;
		justify-self: center;
	}

	@media (min-width: 900px) {
		.hero__inner {
			grid-template-columns: 0.92fr 1.08fr;
			gap: 1.25rem;
		}

		.hero :global(.hero__illus) {
			order: 0;
			width: 100%;
			max-width: 620px;
			justify-self: end;
		}
	}

	/* Les cercles décoratifs vivent dans un calque rogné : laissés libres, ils
	   élargiraient le document et créeraient un défilement horizontal. */
	.decor {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: -1;
	}

	/* Positions relevées sur la charte : un cercle lavande derrière
	   l'illustration, un second sous le bloc de texte. */
	.hero__blob--bas {
		inset-block-end: -38%;
		inset-inline-start: 24%;
		width: 26%;
	}

	.histoire {
		position: relative;
		padding-block-start: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
	}

	/* Le gros cercle qui déborde du bord gauche, au niveau de « Notre histoire ». */
	.histoire__blob {
		inset-block-start: 12%;
		inset-inline-start: -14%;
		width: 26%;
	}

	.histoire__lien {
		margin-top: 0.5rem;
	}

	.valeurs {
		position: relative;
		padding-block-start: clamp(1.25rem, 1rem + 1.2vw, 2rem);
	}

	.valeurs :global(.valeurs__illus) {
		width: 88px;
		height: 88px;
		margin-bottom: 0.6rem;
	}

	.valeurs__blob--droite {
		inset-block-start: -8%;
		inset-inline-end: -8%;
		width: 34%;
	}

	.valeurs__blob--gauche {
		inset-block-end: -18%;
		inset-inline-start: -10%;
		width: 22%;
	}

	.split {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1.35fr 1fr;
			gap: 2rem;
			align-items: start;
		}
	}

	.facts {
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius-lg);
		box-shadow: var(--bb-shadow);
		padding: 1.4rem;
	}

	.facts dl {
		margin: 0;
		display: grid;
		gap: 0.95rem;
	}

	.facts__row {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
	}

	.facts__row :global(.icon-tile) {
		flex-shrink: 0;
	}

	.facts dt {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bb-orange);
		margin-bottom: 0.15rem;
	}

	.facts dd {
		margin: 0;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.97rem;
		color: var(--bb-plum-900);
	}

	/* La note manuscrite déborde à droite des cartes, comme sur la charte. */
	.values {
		position: relative;
	}

	.values :global(.values__note) {
		display: block;
		margin: 1.5rem auto 0;
		max-width: 20ch;
		text-align: center;
	}

	@media (min-width: 1280px) {
		.values :global(.values__note) {
			position: absolute;
			inset-block-start: 1.25rem;
			inset-inline-start: calc(100% - 1.5rem);
			width: 10ch;
			margin: 0;
			text-align: start;
		}
	}

	.actus-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.actus-head .section__intro {
		margin-bottom: 1.5rem;
	}

	.actus-head__link {
		flex-shrink: 0;
	}
</style>
