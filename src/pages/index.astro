---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorTile from '../components/SectorTile.astro';
import ActuCard from '../components/ActuCard.astro';
import CTABanner from '../components/CTABanner.astro';
import Scribble from '../components/Scribble.astro';
import OfficeVideo from '../components/OfficeVideo.astro';
import heroBureau from '../assets/illus/hero-bureau.png';
import { sectors, sectorsLabel } from '../data/company';

const dernieresActus = (await getCollection('actus'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const valeurs = [
	{
		name: 'Proximité',
		description:
			'Une structure à taille humaine, avec des échanges directs et une direction accessible, aussi bien pour nos consultants que pour nos clients.',
	},
	{
		name: 'Expertise',
		description:
			'Des consultants expérimentés et des compétences techniques solides pour répondre aux enjeux de projets exigeants.',
	},
	{
		name: 'Partage',
		description:
			'Les connaissances, les expériences et les bonnes pratiques se partagent. C’est ce qui nous permet de progresser ensemble.',
	},
];

const enBref = [
	{ label: 'Métier', value: 'Conseil en informatique et numérique' },
	{ label: 'Implantation', value: 'Mougins, Sophia-Antipolis (06)' },
	{ label: 'Secteurs', value: sectorsLabel },
	{ label: 'Ce qui nous distingue', value: 'Des relations simples et directes' },
];
---

<BaseLayout
	title="Conseil en informatique et numérique à Sophia-Antipolis"
	description="Blueberry Digital Services accompagne les projets technologiques exigeants dans l'automobile, l'aérien, la défense, l'espace et les télécommunications. Chez nous, l'humain passe avant tout."
>
	<section class="hero">
		<div class="container hero__inner">
			<div class="hero__text">
				<h1>Une structure à taille <span class="accent-word">humaine</span></h1>
				<p class="lead">
					Blueberry Digital Services accompagne ses clients sur des projets technologiques exigeants
					grâce à des consultants spécialisés.
				</p>
				<p class="lead">
					Notre fonctionnement est simple : des échanges directs, de la proximité et une direction
					accessible, avec une attention particulière portée à l’accompagnement de nos consultants.
				</p>
				<div class="hero__actions">
					<a href="/nous-rejoindre" class="btn btn--plum">
						Nous rejoindre <span class="btn__arrow" aria-hidden="true">→</span>
					</a>
					<a href="/actus" class="btn btn--ghost">L’actu Blueberry</a>
				</div>
			</div>

			{/* Les pastilles Expertise/Proximité/Partage font partie de
			    l'illustration ; la note manuscrite, elle, est posée à côté. */}
			<div class="hero__visual">
				<Image
					src={heroBureau}
					alt=""
					widths={[480, 960]}
					sizes="(max-width: 900px) 88vw, 480px"
					format="webp"
					loading="eager"
					fetchpriority="high"
					class="hero__illus"
				/>
				{/* La coupe est écrite dans le texte : les étincelles se posent aux
				    bords de la boîte, qui doit donc coller à la plus longue ligne. */}
				<Scribble
					text={'Des compétences\nderrière chaque projet'}
					sparks
					rotate={6}
					class="hero__note"
				/>
			</div>
		</div>
	</section>

	<section class="section histoire">
		<div class="container split">
			<div class="prose">
				<h2>Blueberry, simplement</h2>
				<p>
					Chez Blueberry Digital Services, nous pensons que la réussite d’un projet informatique
					repose avant tout sur les personnes qui le construisent.
				</p>
				<p>
					Notre fonctionnement est simple : une structure à taille humaine, des échanges directs,
					des décisions rapides et une direction accessible. Cela se retrouve aussi bien dans notre
					façon de recruter et d’accompagner nos consultants que dans notre relation avec nos
					clients.
				</p>
				<p>
					Nous accompagnons managers et équipes sur leurs projets numériques, avec une expertise
					technique solide pour concevoir des solutions robustes et sécurisées. Grâce à nos
					différentes expertises, nous intervenons dans <a href="#secteurs">plusieurs secteurs
					d’activité</a>.
				</p>
				<p>
					Et parce que la vie chez Blueberry ne se résume pas aux projets, on partage aussi des
					moments ensemble : sorties en bateau, journées au ski, Jeux de Sophia…
					<a href="/actus">Découvrez la vie chez Blueberry sur notre page Actus</a>.
				</p>
			</div>

			<aside class="facts">
				<h2>En bref</h2>
				<dl>
					{
						enBref.map((fait) => (
							<div class="facts__row">
								<dt>{fait.label}</dt>
								<dd>{fait.value}</dd>
							</div>
						))
					}
				</dl>
			</aside>
		</div>
	</section>

	<section class="section valeurs">
		<div class="container">
			<div class="section__intro">
				<h2>Nos valeurs</h2>
			</div>

			<div class="values">
				<div class="split">
					<div class="values__cards">
						{
							valeurs.map((valeur) => (
								<article class="card values__card">
									<h3>{valeur.name}</h3>
									<p class="muted">{valeur.description}</p>
								</article>
							))
						}
					</div>
					<div class="values__media">
						<OfficeVideo />
						<Scribble text="Des valeurs qui nous font grandir" sparks rotate={-8} class="values__note" />
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section secteurs" id="secteurs">
		<div class="container">
			<div class="section__intro">
				<h2>Nos secteurs d’activité</h2>
				<p class="lead">
					Nos consultants interviennent principalement sur des projets de développement logiciel,
					dans des secteurs où les enjeux techniques et les contraintes métier sont importants.
				</p>
			</div>

			<ul class="secteurs__list">
				{sectors.map((sector) => <SectorTile {...sector} />)}
			</ul>
		</div>
	</section>

	{
		dernieresActus.length > 0 && (
			<section class="section section--soft">
				<div class="container">
					<div class="actus-head">
						<div class="section__intro">
							<h2>La vie chez Blueberry</h2>
							<p class="lead">
								Sorties, événements, moments partagés : ce qui se passe chez nous quand on ne code
								pas.
							</p>
						</div>
						<a href="/actus" class="btn btn--ghost actus-head__link">
							Toutes les actus <span class="btn__arrow" aria-hidden="true">→</span>
						</a>
					</div>

					<div class="grid grid--3">
						{dernieresActus.map((entry, i) => (
							<ActuCard entry={entry} eager={i === 0} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CTABanner
		title="Envie de rejoindre l’aventure ?"
		text="Des projets ambitieux, une équipe soudée et un cadre de vie unique en plein cœur de la Côte d’Azur."
		ctaLabel="Nous rejoindre"
		ctaHref="/nous-rejoindre"
	/>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding-block: clamp(1.25rem, 0.9rem + 2vw, 2.5rem);
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		gap: 1rem;
		align-items: center;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.hero__visual {
		order: -1;
		position: relative;
		justify-self: center;
	}

	.hero :global(.hero__illus) {
		display: block;
		/* L'illustration est nettement plus haute que celle de l'actu (ratio
		   1,59 contre 2,05) : on la borne par la largeur pour que les deux
		   pages affichent un visuel de hauteur comparable. */
		width: min(88vw, 360px);
		height: auto;
		/* Le plan de travail de l'illustration est un aplat opaque qui va d'un
		   bord à l'autre : sans ce fondu, son rectangle se découpe nettement
		   sur les taches du décor. Le fondu ne démarre qu'à 86 %, sous le
		   clavier, pour ne pas effacer la tasse et les pots. */
		-webkit-mask-image: linear-gradient(180deg, #000 86%, transparent 100%);
		mask-image: linear-gradient(180deg, #000 86%, transparent 100%);
	}

	/* La note se pose en biais dans le coin haut droit de l'illustration. Le
	   PNG y est transparent jusqu'aux pointes de la mascotte, qui ne montent
	   qu'à 12 % de la hauteur : la note mord sur ce vide et déborde au-dessus
	   de l'image, dans la respiration de la section. L'écart au bord droit
	   dégage l'étincelle de fin, qui sort de la boîte d'environ 1,35 em. */
	.hero :global(.hero__note) {
		position: absolute;
		inset-block-start: -0.4em;
		inset-inline-end: 1.5em;
		margin: 0;
		/* Les étincelles se posent aux coins hauts de la boîte, donc de part et
		   d'autre de la première ligne : la boîte se règle sur la plus longue
		   ligne (coupe écrite dans le texte) et les lignes sont centrées, sinon
		   l'une des deux étincelles se retrouve à distance du texte. */
		white-space: pre-line;
		width: max-content;
		text-align: center;
	}

	@media (min-width: 900px) {
		.hero__inner {
			/* La colonne visuelle est calée sur la largeur de l'illustration :
			   avec une fraction, le texte se serait resserré pour rien. */
			grid-template-columns: 1fr minmax(0, 480px);
			gap: 1.75rem;
		}

		.hero__visual {
			order: 0;
			justify-self: end;
			width: 100%;
			max-width: 480px;
		}

		.hero :global(.hero__illus) {
			width: 100%;
		}
	}

	/* Sur deux lignes la note est plus large que le coin libre, d'où la bande
	   réservée à droite dans laquelle elle déborde : la colonne s'élargit
	   d'autant, l'illustration garde la largeur qu'elle avait. Elle n'a alors
	   plus besoin de remonter au-dessus de l'image. */
	@media (min-width: 1100px) {
		.hero__inner {
			grid-template-columns: 1fr minmax(0, 560px);
		}

		.hero__visual {
			max-width: 560px;
			/* La colonne s'élargit d'autant que la bande : l'illustration garde
			   sa largeur et la note s'écarte de la tête du personnage. */
			padding-inline-end: 5rem;
		}

		.hero :global(.hero__note) {
			inset-block-start: 0;
			inset-inline-end: 1.6em;
		}
	}

	.histoire {
		position: relative;
		padding-block-start: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
	}

	.secteurs {
		position: relative;
	}

	.secteurs .section__intro {
		margin-bottom: 1.1rem;
	}

	/* Cinq secteurs ne se répartissent en rangées pleines qu'à partir de cinq
	   colonnes : en dessous il reste toujours un reliquat. Une grille le
	   laisserait pendre à gauche, d'où le flex, qui centre la dernière rangée.
	   La largeur des tuiles est calculée pour retomber sur un nombre fixe par
	   rangée — sans elle, le nombre dépendrait de la largeur disponible.
	   Les tuiles n'ayant pas de cadre, c'est l'écart qui fait la structure :
	   la gouttière de ligne est plus large que celle de colonne. */
	.secteurs__list {
		--sector-gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: flex-start;
		gap: 1.75rem var(--sector-gap);
	}

	.secteurs__list > :global(li) {
		flex: 0 0 calc((100% - var(--sector-gap)) / 2);
	}

	@media (min-width: 560px) {
		.secteurs__list > :global(li) {
			flex-basis: calc((100% - 2 * var(--sector-gap)) / 3);
		}
	}

	@media (min-width: 900px) {
		.secteurs__list {
			--sector-gap: 1.5rem;
			gap: var(--sector-gap);
		}

		.secteurs__list > :global(li) {
			flex-basis: calc((100% - 4 * var(--sector-gap)) / 5);
		}
	}

	.valeurs {
		position: relative;
		padding-block-start: clamp(1.25rem, 1rem + 1.2vw, 2rem);
	}

	.values__cards {
		display: grid;
		gap: 0.9rem;
	}

	/* Sans picto, la carte tient sur son titre et un filet vertical, qui
	   remplace la bordure gauche pour ne pas doubler le trait. */
	.values__card {
		position: relative;
		padding-inline-start: 1.6rem;
		overflow: hidden;
	}

	.values__card::before {
		content: '';
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 4px;
		background: linear-gradient(180deg, var(--bb-plum-500), var(--bb-orange));
		opacity: 0.45;
	}

	.values__card h3 {
		margin-bottom: 0.3rem;
	}

	.values__card p {
		margin-bottom: 0;
		font-size: 0.95rem;
	}

	.split {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1.35fr 1fr;
			gap: 2rem;
			align-items: start;
		}
	}

	/* Le panneau reprend le lavande des motifs du décor plutôt qu'un aplat
	   blanc : il se pose sur la page sans avoir besoin d'ombre. */
	.histoire .split {
		/* Partagé par le panneau et la colonne de texte, qui se cale dessus. */
		--facts-pad: 1.4rem;
	}

	.facts {
		background: var(--bb-blob);
		border-radius: var(--bb-radius-lg);
		padding: var(--facts-pad);
	}

	.facts h2 {
		font-size: 1.05rem;
		margin-bottom: 1rem;
	}

	/* Le titre du panneau est en retrait de son padding : sans compensation il
	   tombe plus bas que « Notre histoire ». On descend donc la colonne de texte
	   d'autant, ce qui laisse le bord du panneau marquer le haut de la ligne.
	   Sous 900px les colonnes s'empilent, ce décalage n'aurait plus d'objet. */
	@media (min-width: 900px) {
		.histoire .prose {
			padding-block-start: var(--facts-pad);
		}
	}

	.facts dl {
		margin: 0;
		display: grid;
	}

	/* Un filet entre chaque entrée : sans lui les quatre lignes flottent dans le
	   panneau. Le premier bord serait collé au titre, d'où le `+`. */
	.facts__row + .facts__row {
		border-block-start: 1px solid var(--bb-border-strong);
		margin-block-start: 0.9rem;
		padding-block-start: 0.9rem;
	}

	.facts dt {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bb-orange);
		margin-bottom: 0.15rem;
	}

	.facts dd {
		margin: 0;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.97rem;
		color: var(--bb-plum-900);
	}

	/* La note vit sous la vidéo : centrée au milieu du bloc, elle tombait dans
	   la gouttière entre les deux colonnes. L'écart est plus large qu'une
	   gouttière ordinaire car la note est inclinée : son coin haut droit et son
	   étincelle montent d'une trentaine de pixels au-dessus de sa boîte, et
	   venaient mordre sur la vidéo. */
	.values__media {
		display: grid;
		gap: 2.5rem;
		align-content: start;
	}

	.values :global(.values__note) {
		display: block;
		justify-self: center;
		/* Les étincelles se posent aux bords de la boîte : au plus juste de la
		   ligne la plus longue (« nous font grandir », 6,1 em en Caveat), elles
		   encadrent le texte au lieu de flotter à distance. */
		max-width: 14ch;
		text-align: center;
		/* Le cadre de la vidéo est remonté d'un cran pour couvrir son losange ;
		   sans ce rang-là, la note inclinée repasserait dessous. */
		position: relative;
		z-index: 2;
	}

	.actus-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		/* Sur la marge, pas sur `.section__intro` : dans une ligne flex, la marge
		   d'un enfant ne dépasse pas la hauteur du plus grand des deux, donc si
		   le lien est plus haut que le texte elle ne se voyait pas — la grille
		   se retrouvait collée au bloc. */
		margin-bottom: 1.5rem;
	}

	.actus-head .section__intro {
		margin-bottom: 0;
	}

	.actus-head__link {
		flex-shrink: 0;
	}
</style>
