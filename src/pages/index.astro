---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorCard from '../components/SectorCard.astro';
import ActuCard from '../components/ActuCard.astro';
import CTABanner from '../components/CTABanner.astro';
import Scribble from '../components/Scribble.astro';
import Icon from '../components/Icon.astro';
import OfficeVideo from '../components/OfficeVideo.astro';
import heroBureau from '../assets/illus/hero-bureau.png';
import { sectors, sectorsLabel } from '../data/company';

const dernieresActus = (await getCollection('actus'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const valeurs = [
	{
		name: 'Expertise',
		description:
			'Une expertise technique de pointe, entretenue en continu pour accompagner des projets exigeants.',
	},
	{
		name: 'Proximité',
		description:
			'Une structure à taille humaine où l’on connaît tout le monde, avec une direction toujours accessible.',
	},
	{
		name: 'Partage',
		description:
			'On avance ensemble. Les réussites comme les difficultés d’un projet se partagent.',
	},
];

const enBref = [
	{ icon: 'briefcase', label: 'En bref', value: 'Conseil en informatique et numérique' },
	{ icon: 'pin', label: 'Implantation', value: 'Mougins, Sophia-Antipolis (06)' },
	{ icon: 'sectors', label: 'Secteurs', value: sectorsLabel },
	{ icon: 'star', label: 'Ce qui nous distingue', value: 'Le bien-être génère la performance' },
];
---

<BaseLayout
	title="Conseil en informatique et numérique à Sophia-Antipolis"
	description="Blueberry Digital Services accompagne les projets technologiques exigeants dans l'automobile, l'aérien, la défense, l'espace et les télécommunications. Chez nous, l'humain passe avant tout."
>
	<section class="hero">
		<div class="container hero__inner">
			<div class="hero__text">
				<h1>Une entreprise à taille <span class="accent-word">humaine</span></h1>
				<p class="lead">
					Blueberry Digital Services accompagne ses clients sur des projets technologiques exigeants.
					Notre conviction est simple : le bien-être génère la performance, et l’humain passe avant
					tout.
				</p>
				<div class="hero__actions">
					<a href="/nous-rejoindre" class="btn btn--plum">
						Nous rejoindre <span class="btn__arrow" aria-hidden="true">→</span>
					</a>
					<a href="#secteurs" class="btn btn--ghost">Nos secteurs</a>
				</div>
			</div>

			{/* Les pastilles Expertise/Proximité/Partage font partie de
			    l'illustration ; la note manuscrite, elle, est posée à côté. */}
			<div class="hero__visual">
				<Image
					src={heroBureau}
					alt=""
					widths={[480, 960]}
					sizes="(max-width: 900px) 88vw, 480px"
					format="webp"
					loading="eager"
					fetchpriority="high"
					class="hero__illus"
				/>
				<Scribble text="Des talents derrière les technologies !" rotate={-6} class="hero__note" />
			</div>
		</div>
	</section>

	<section class="section histoire">
		<div class="container split">
			<div class="prose">
				<h2>Notre histoire</h2>
				<p>
					Depuis sa création, Blueberry Digital Services a adopté une approche singulière dans un
					secteur qui l’est rarement : considérer que la performance d’un projet informatique tient
					d’abord à celles et ceux qui le portent.
				</p>
				<p>
					Nous considérons que chaque projet est avant tout une aventure humaine : une structure à
					taille humaine où l’on connaît tout le monde, des décisions qui ne trainent pas des mois, et
					une direction accessible. C’est ce qui guide notre manière de recruter, d’accompagner nos
					consultants et de travailler avec nos clients.
				</p>
				<p>
					Nous aidons managers et équipes à anticiper les enjeux du numérique avec une expertise
					technique de pointe, pour des produits robustes et sécurisés. Notre approche multi-spécialiste
					nous permet d’intervenir dans <a href="#secteurs">plusieurs secteurs d’activité</a>.
				</p>
				<p>
					Nous croyons que l’avenir de l’entreprise est ouvert et collaboratif. Concrètement : une
					structure à taille humaine où l’on connaît tout le monde, des décisions qui ne mettent pas
					six mois à être prises, et une direction accessible.
				</p>
				<p>
					Le reste se raconte mieux en images : sorties en bateau, journées au ski, Jeux de
					Sophia… <a href="/actus">la vie chez Blueberry est sur la page actu</a>.
				</p>
			</div>

			<aside class="facts">
				<h2 class="visually-hidden">En bref</h2>
				<dl>
					{
						enBref.map((fait) => (
							<div class="facts__row">
								<span class="icon-tile icon-tile--sm">
									<Icon name={fait.icon} />
								</span>
								<div>
									<dt>{fait.label}</dt>
									<dd>{fait.value}</dd>
								</div>
							</div>
						))
					}
				</dl>
			</aside>
		</div>
	</section>

	<section class="section valeurs">
		<div class="container">
			<div class="section__intro">
				<h2>Nos valeurs</h2>
			</div>

			<div class="values">
				<div class="split">
					<div class="values__cards">
						{
							valeurs.map((valeur) => (
								<article class="card card--lift values__card">
									<h3>{valeur.name}</h3>
									<p class="muted">{valeur.description}</p>
								</article>
							))
						}
					</div>
					<div class="values__media">
						<OfficeVideo />
						<Scribble text="Des valeurs qui nous font grandir" rotate={-8} class="values__note" />
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="secteurs">
		<div class="container">
			<div class="section__intro">
				<h2>Nos secteurs d’activité</h2>
				<p class="lead">
					Une approche multi-spécialiste qui nous permet de proposer des services à forte valeur
					ajoutée dans des domaines où la qualité, la robustesse et la sécurité ne sont pas
					négociables.
				</p>
			</div>

			<div class="grid grid--5">
				{sectors.map((sector) => <SectorCard {...sector} />)}
			</div>
		</div>
	</section>

	{
		dernieresActus.length > 0 && (
			<section class="section section--soft">
				<div class="container">
					<div class="actus-head">
						<div class="section__intro">
							<h2>La vie chez Blueberry</h2>
							<p class="lead">
								Sorties, événements, moments partagés : ce qui se passe chez nous quand on ne code
								pas.
							</p>
						</div>
						<a href="/actus" class="btn btn--ghost actus-head__link">
							Toutes les actus <span class="btn__arrow" aria-hidden="true">→</span>
						</a>
					</div>

					<div class="grid grid--3">
						{dernieresActus.map((entry, i) => (
							<ActuCard entry={entry} eager={i === 0} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CTABanner
		title="Envie de rejoindre l’aventure ?"
		text="Des projets ambitieux, une équipe soudée et un cadre de vie unique en plein cœur de la Côte d’Azur."
		ctaLabel="Nous rejoindre"
		ctaHref="/nous-rejoindre"
	/>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding-block: clamp(1.25rem, 0.9rem + 2vw, 2.5rem);
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		gap: 1rem;
		align-items: center;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.hero__visual {
		order: -1;
		position: relative;
		justify-self: center;
	}

	.hero :global(.hero__illus) {
		display: block;
		/* L'illustration est nettement plus haute que celle de l'actu (ratio
		   1,59 contre 2,05) : on la borne par la largeur pour que les deux
		   pages affichent un visuel de hauteur comparable. */
		width: min(88vw, 360px);
		height: auto;
		/* Le plan de travail de l'illustration est un aplat opaque qui va d'un
		   bord à l'autre : sans ce fondu, son rectangle se découpe nettement
		   sur les taches du décor. Le fondu ne démarre qu'à 86 %, sous le
		   clavier, pour ne pas effacer la tasse et les pots. */
		-webkit-mask-image: linear-gradient(180deg, #000 86%, transparent 100%);
		mask-image: linear-gradient(180deg, #000 86%, transparent 100%);
	}

	/* Sous 900px la note passe sous l'illustration : à sa place en absolu, elle
	   chevaucherait la mascotte. */
	.hero :global(.hero__note) {
		display: block;
		max-width: 22ch;
		margin: 0.5rem auto 0;
		text-align: center;
	}

	@media (min-width: 900px) {
		.hero__inner {
			/* La colonne visuelle est calée sur la largeur de l'illustration :
			   avec une fraction, le texte se serait resserré pour rien. */
			grid-template-columns: 1fr minmax(0, 480px);
			gap: 1.75rem;
		}

		.hero__visual {
			order: 0;
			justify-self: end;
			width: 100%;
			max-width: 480px;
		}

		.hero :global(.hero__illus) {
			width: 100%;
		}

		.hero :global(.hero__note) {
			position: absolute;
			inset-block-start: 4%;
			inset-inline-end: -1rem;
			max-width: 11ch;
			margin: 0;
			text-align: start;
		}
	}

	.histoire {
		position: relative;
		padding-block-start: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
	}

	.valeurs {
		position: relative;
		padding-block-start: clamp(1.25rem, 1rem + 1.2vw, 2rem);
	}

	.values__cards {
		display: grid;
		gap: 0.9rem;
	}

	/* Sans picto, la carte tient sur son titre et un filet vertical, qui
	   remplace la bordure gauche pour ne pas doubler le trait. */
	.values__card {
		position: relative;
		padding-inline-start: 1.6rem;
		overflow: hidden;
	}

	.values__card::before {
		content: '';
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 4px;
		background: linear-gradient(180deg, var(--bb-plum-500), var(--bb-orange));
		opacity: 0.45;
		transition: opacity 0.18s ease;
	}

	.values__card:hover::before {
		opacity: 1;
	}

	.values__card h3 {
		margin-bottom: 0.3rem;
	}

	.values__card p {
		margin-bottom: 0;
		font-size: 0.95rem;
	}

	.split {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1.35fr 1fr;
			gap: 2rem;
			align-items: start;
		}
	}

	.facts {
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius-lg);
		box-shadow: var(--bb-shadow);
		padding: 1.4rem;
	}

	.facts dl {
		margin: 0;
		display: grid;
	}

	/* Un filet entre chaque entrée : sans lui les quatre lignes flottent dans le
	   panneau. Le premier bord serait collé au haut de la carte, d'où le `+`. */
	.facts__row + .facts__row {
		border-block-start: 1px solid var(--bb-border);
		margin-block-start: 0.9rem;
		padding-block-start: 0.9rem;
	}

	.facts__row {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
	}

	.facts__row :global(.icon-tile) {
		flex-shrink: 0;
	}

	.facts dt {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bb-orange);
		margin-bottom: 0.15rem;
	}

	.facts dd {
		margin: 0;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.97rem;
		color: var(--bb-plum-900);
	}

	/* La note vit sous la vidéo : centrée au milieu du bloc, elle tombait dans
	   la gouttière entre les deux colonnes. */
	.values__media {
		display: grid;
		gap: 1.25rem;
		align-content: start;
	}

	.values :global(.values__note) {
		display: block;
		justify-self: center;
		max-width: 20ch;
		text-align: center;
	}

	.actus-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.actus-head .section__intro {
		margin-bottom: 1.5rem;
	}

	.actus-head__link {
		flex-shrink: 0;
	}
</style>
