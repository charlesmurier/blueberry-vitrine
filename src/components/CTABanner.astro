---
import { Image } from 'astro:assets';
import Scribble from './Scribble.astro';
import photo from '../assets/illus/jds.png';

interface Props {
	title: string;
	text?: string;
	ctaLabel: string;
	ctaHref: string;
	secondaryLabel?: string;
	secondaryHref?: string;
	/** Annotation manuscrite posée par-dessus la photo. */
	note?: string;
}

const { title, text, ctaLabel, ctaHref, secondaryLabel, secondaryHref, note } = Astro.props;
---

<section class="cta">
	<div class="container">
		<div class="cta__panel">
			<Image
				src={photo}
				alt=""
				widths={[560, 1120]}
				sizes="(max-width: 780px) 100vw, 560px"
				format="webp"
				loading="lazy"
				class="cta__photo"
			/>

			<div class="cta__content">
				<h2>{title}</h2>
				{text && <p>{text}</p>}
				<div class="cta__actions">
					<a href={ctaHref} class="btn btn--plum">
						{ctaLabel} <span class="btn__arrow" aria-hidden="true">→</span>
					</a>
					{
						secondaryLabel && secondaryHref && (
							<a href={secondaryHref} class="btn btn--on-dark">
								{secondaryLabel}
							</a>
						)
					}
				</div>
			</div>

			{note && <Scribble text={note} underline rotate={-4} class="cta__note" />}
		</div>
	</div>
</section>

<style>
	.cta {
		padding-block: clamp(1.75rem, 1.3rem + 2vw, 3rem);
	}

	.cta__panel {
		/* Repris par la photo en version mobile, qui doit déborder du padding
		   pour toucher les bords du panneau. */
		--cta-pad: clamp(1.75rem, 1.2rem + 3vw, 2.5rem);

		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-radius: var(--bb-radius-lg);
		background: linear-gradient(120deg, #cdc2f3, #e4d9f5 45%, #f3e2e6);
		padding: var(--cta-pad);
		min-height: 280px;
		display: flex;
		align-items: center;
	}

	/* La photo occupe la moitié droite et se fond dans le dégradé du panneau. */
	.cta__panel :global(.cta__photo) {
		position: absolute;
		inset-block: 0;
		inset-inline-end: 0;
		z-index: -1;
		width: 52%;
		height: 100%;
		object-fit: cover;
		/* Le bandeau est bien plus large que la photo : le recadrage se fait en
		   hauteur. Une colonne plus étroite fait moins zoomer l'image, donc laisse
		   voir plus de hauteur — c'est ce qui garde le groupe entier dans le cadre. */
		object-position: center 8%;
		mask-image: linear-gradient(90deg, transparent, #000 32%);
	}

	.cta__content {
		max-width: 42ch;
	}

	.cta__panel h2 {
		margin-bottom: 0.4rem;
	}

	.cta__panel p {
		color: var(--bb-plum-900);
		opacity: 0.8;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.cta__panel :global(.cta__note) {
		display: none;
	}

	@media (min-width: 900px) {
		.cta__panel {
			min-height: 345px;
		}

		.cta__panel :global(.cta__note) {
			display: block;
			position: absolute;
			inset-block-start: 2rem;
			inset-inline-end: 2.25rem;
			width: 11ch;
			text-align: start;
		}
	}

	/* Sous 780px il n'y a plus la place de mettre la photo à côté du texte. On la
	   sort du positionnement absolu pour l'empiler sous le contenu : elle est
	   alors affichée entière, donc aucun recadrage ne peut couper une tête et le
	   bouton ne peut plus recouvrir un visage. */
	@media (max-width: 779px) {
		.cta__panel {
			flex-direction: column;
			align-items: stretch;
		}

		.cta__panel :global(.cta__photo) {
			position: static;
			order: 1;
			z-index: auto;
			/* Marges négatives : la photo ressort du padding pour aller toucher les
			   bords arrondis du panneau. */
			width: calc(100% + var(--cta-pad) * 2);
			/* Sans ça, le `max-width: 100%` global des images annule le débord et
			   laisse une bande de dégradé à droite de la photo. */
			max-width: none;
			height: auto;
			/* Vers 780px la photo pleine largeur ferait 500px de haut et écraserait
			   le reste du bandeau. On la plafonne, en recadrant par le bas : le
			   premier rang reste entier, seuls les pieds sont rognés. */
			max-height: 430px;
			object-position: center top;
			margin: var(--cta-pad) calc(var(--cta-pad) * -1) calc(var(--cta-pad) * -1);
			/* Le haut du crâne du monsieur sur le podium est à quelques pixels du
			   bord de la photo : le fondu doit rester court pour ne pas l'effacer. */
			mask-image: linear-gradient(180deg, transparent, #000 10%);
		}
	}
</style>
