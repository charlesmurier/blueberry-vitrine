---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	illus: ImageMetadata;
	name: string;
	description: string;
}

const { illus, name, description } = Astro.props;
---

<article class="card card--lift sector">
	<Image src={illus} alt="" widths={[152]} sizes="76px" format="webp" class="illus illus--lg" />
	<h3>{name}</h3>
	<p>{description}</p>
</article>

<style>
	.sector :global(.illus) {
		margin-inline: auto;
	}

	.sector {
		text-align: center;
	}

	.sector p {
		color: var(--bb-muted);
		font-size: 0.92rem;
		margin-bottom: 0;
	}
</style>
