---
/**
 * Le décor de fond de la charte : des taches en aplat, très pâles, semées
 * de-ci de-là. Deux familles de formes seulement.
 *
 * - `tache` : un cercle volontairement déformé (sept rayons irréguliers
 *   raccordés en courbes), jamais un cercle parfait.
 * - `feuille` : un rappel de la feuille du logo, remplie. C'est une lentille
 *   pointue aux deux bouts, de demi-largeur 0,20 × longueur — proportion
 *   relevée sur le logo (38 px de long pour 7,5 de demi-largeur).
 *
 * Le calque couvre toute la hauteur de <main> et les formes sont placées en
 * pourcentage : elles se répartissent sur la page quelle que soit sa longueur,
 * sans motif qui se répète. Les largeurs passent par `min(<px>, <vw>)` pour
 * se réduire d'elles-mêmes sur mobile.
 */

/** Cercles irréguliers, normalisés dans un viewBox 0 0 100 100. */
const TACHES = [
	'M98 46.3c-.5 14.2-13.7 32.7-23.7 40.8c-10 8.2-25.3 10.7-36.5 8.1c-11.2-2.6-24.6-11.7-30.6-23.8c-6-12.1-9.7-37.9-5.2-49c4.5-11.2 19.8-14.5 32.3-17.9c12.6-3.4 32.5-9.4 43.1-2.4c10.6 7 21.1 30.1 20.5 44.3z',
	'M98 51.8c.1 11.3-21 21.4-31.7 27.7c-10.8 6.3-23 13.1-32.8 10.3c-9.7-2.7-20.4-16.5-25.7-26.6c-5.2-10.1-9.7-23.7-5.8-33.9c3.9-10.2 18.6-24.4 29.2-27.4c10.6-2.9 23.2 1.4 34.3 9.7c11.1 8.3 32.3 28.8 32.5 40z',
	'M86.3 53.5c.9 13.6.2 34-9.3 41.5c-9.5 7.4-35 7.2-47.5 3.1c-12.5-4.1-23.7-16.9-27.5-27.8c-3.8-10.8-.9-25.9 4.7-37.3c5.6-11.4 18.2-27.7 29-30.9c10.8-3.2 27.3 2.9 35.8 11.5c8.4 8.6 13.9 26.4 14.9 40z',
	'M98 53.7c.5 11.3-9.5 29-20.5 35.9c-11 6.9-33 8.6-45.6 5.4c-12.6-3.2-27-14-29.9-24.4c-2.9-10.4 7.6-26.5 12.4-38c4.8-11.4 6.4-28.7 16.4-30.6c10.1-1.8 32.8 10.9 43.9 19.5c11.2 8.6 22.7 20.9 23.2 32.2z',
	'M90.2 48.7c-1.7 12-13.8 28.4-23.2 36.7c-9.5 8.2-22.7 15.5-33.5 12.7c-10.8-2.8-26.1-18.5-31.4-29.7c-5.2-11.2-4.3-26.7-.1-37.8c4.2-11 12.8-25.6 25.3-28.5c12.6-2.9 39.5 3.3 50 11c10.5 7.8 14.6 23.6 12.9 35.6z',
	'M98 47.5c-.2 12.2-6.3 31.9-17 40.3c-10.6 8.4-34 12.3-46.8 10.1c-12.8-2.2-24.5-10.6-29.8-23.1c-5.4-12.5-7.2-39.6-2.4-51.7c4.8-12.2 17.6-19.8 31-21.2c13.4-1.4 38.7 5.3 49.5 12.9c10.8 7.6 15.7 20.5 15.5 32.6z',
	'M97.8 46c0 11.6-12 25.3-22.2 33.9c-10.2 8.7-26.8 19.8-39.1 18.1c-12.3-1.7-29.4-16.2-34.5-28.5c-5.1-12.2-.5-33.6 3.8-44.9c4.3-11.3 10.3-20.3 22-22.7c11.7-2.4 36.4.8 48.1 8.2c11.7 7.3 22 24.2 22 35.9z',
	'M98 37.2c.6 13.2-6.7 35.6-17.7 44c-11 8.3-36.7 10-48.3 6.1c-11.7-3.9-16.7-17.1-21.7-29.3c-5-12.2-12.6-34.6-8.4-43.8c4.3-9.2 21.6-9.6 34.1-11.6c12.4-2 30.3-6.4 40.6-.6c10.3 5.8 20.7 22 21.3 35.2z',
];

/** La feuille, dans un viewBox 0 0 100 40 : pointue en 0 et en 100. */
const FEUILLE =
	'M0 20C16.7.4 83.3.4 100 20C83.3 39.6 16.7 39.6 0 20z';

type Forme = {
	/** Index dans TACHES, ou `feuille` */
	forme: number | 'feuille';
	/** Teinte : lavande, lavande pâle, pêche, pêche pâle */
	ton: 'lav' | 'lav-soft' | 'peach' | 'peach-soft';
	/** Largeur de référence en px, sur une page de 1440 */
	w: number;
	/** Décalage horizontal : `g` depuis la gauche, `d` depuis la droite, en % */
	g?: number;
	d?: number;
	/** Position verticale, en % de la hauteur de la page */
	y: number;
	/** Rotation en degrés */
	rot?: number;
};

const formes: Forme[] = [
	{ forme: 0, ton: 'lav', w: 250, g: -7, y: 2 },
	{ forme: 'feuille', ton: 'peach', w: 185, d: -2, y: 8, rot: -28 },
	{ forme: 3, ton: 'peach-soft', w: 70, g: 8, y: 12, rot: 20 },
	{ forme: 1, ton: 'lav-soft', w: 88, g: 73, y: 15 },
	{ forme: 'feuille', ton: 'peach-soft', w: 78, d: 18, y: 18, rot: -40 },
	{ forme: 'feuille', ton: 'lav-soft', w: 120, g: 18, y: 21, rot: -58 },
	{ forme: 5, ton: 'lav-soft', w: 105, g: 46, y: 24, rot: 140 },
	{ forme: 2, ton: 'lav', w: 280, d: -8, y: 27 },
	{ forme: 7, ton: 'peach-soft', w: 82, g: -2, y: 32, rot: 60 },
	{ forme: 'feuille', ton: 'lav-soft', w: 110, d: 8, y: 36, rot: 18 },
	{ forme: 'feuille', ton: 'peach-soft', w: 150, g: 54, y: 39, rot: 24 },
	{ forme: 1, ton: 'lav', w: 130, d: -4, y: 43, rot: 200 },
	{ forme: 3, ton: 'peach-soft', w: 120, g: 62, y: 46 },
	{ forme: 'feuille', ton: 'peach', w: 88, g: 24, y: 49, rot: -34 },
	{ forme: 4, ton: 'lav-soft', w: 190, g: -5, y: 52 },
	{ forme: 6, ton: 'peach-soft', w: 72, g: 70, y: 57, rot: 90 },
	{ forme: 'feuille', ton: 'peach-soft', w: 92, d: 11, y: 61, rot: 42 },
	{ forme: 'feuille', ton: 'lav-soft', w: 125, g: 6, y: 64, rot: -22 },
	{ forme: 5, ton: 'lav-soft', w: 225, d: -5, y: 68 },
	{ forme: 0, ton: 'peach-soft', w: 90, g: 40, y: 73, rot: 250 },
	{ forme: 6, ton: 'lav', w: 170, g: -4, y: 79 },
	{ forme: 2, ton: 'lav-soft', w: 115, d: 3, y: 83, rot: 120 },
	{ forme: 'feuille', ton: 'peach', w: 105, g: 29, y: 85, rot: -16 },
	{ forme: 7, ton: 'peach-soft', w: 95, d: 24, y: 90 },
	{ forme: 'feuille', ton: 'lav-soft', w: 130, d: 5, y: 94, rot: 62 },
	{ forme: 4, ton: 'peach-soft', w: 78, g: 14, y: 97, rot: 160 },
];

/** La largeur suit l'écran en dessous de 1440 px, sans jamais dépasser sa taille de référence. */
const largeur = (w: number) => `min(${w}px, ${((w / 1440) * 100).toFixed(1)}vw)`;
---

<div class="decor" aria-hidden="true">
	{
		formes.map((f) => {
			const pos = f.g !== undefined ? `left:${f.g}%` : `right:${f.d}%`;
			const style = [
				pos,
				`top:${f.y}%`,
				`width:${largeur(f.w)}`,
				f.rot ? `rotate:${f.rot}deg` : '',
			]
				.filter(Boolean)
				.join(';');

			return f.forme === 'feuille' ? (
				<svg class={`decor__forme decor__forme--${f.ton}`} viewBox="0 0 100 40" style={style}>
					<path d={FEUILLE} />
				</svg>
			) : (
				<svg class={`decor__forme decor__forme--${f.ton}`} viewBox="0 0 100 100" style={style}>
					<path d={TACHES[f.forme]} />
				</svg>
			);
		})
	}
</div>

<style>
	/* Le calque est rogné : sans cela les formes qui débordent des bords
	   élargiraient le document et créeraient un défilement horizontal. */
	.decor {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: -1;
	}

	.decor__forme {
		position: absolute;
		height: auto;
		fill: currentcolor;
	}

	.decor__forme--lav {
		color: var(--bb-blob);
	}

	.decor__forme--lav-soft {
		color: var(--bb-blob-soft);
	}

	.decor__forme--peach {
		color: var(--bb-blob-peach);
	}

	.decor__forme--peach-soft {
		color: var(--bb-blob-peach-soft);
	}
</style>
