---
/**
 * Pictogrammes maison, bicolores : le tracé principal reprend la couleur
 * héritée, les tracés marqués `accent` passent en orange (voir global.css).
 * Ils remplacent les emoji, dont le rendu changeait d'un appareil à l'autre.
 */
interface Props {
	name: string;
	class?: string;
}

const { name, class: className } = Astro.props;

const shapes: Record<string, string> = {
	// Secteurs d'activité
	car: `<path d="M4.5 15.6v-2.8a2 2 0 0 1 .5-1.32l1.4-1.6 1.06-2.32A2 2 0 0 1 9.28 6.4h5.44a2 2 0 0 1 1.82 1.16l1.06 2.32 1.4 1.6a2 2 0 0 1 .5 1.32v2.8a1 1 0 0 1-1 1h-1.6a1 1 0 0 1-1-1v-.4H6.1v.4a1 1 0 0 1-1 1H3.5"/><path d="M6.4 10.9h11.2"/><path d="M8.3 13.5h.01M15.7 13.5h.01" class="accent" stroke-width="2.6"/>`,
	plane: `<path d="M10.6 3.4a1.4 1.4 0 0 1 2.8 0v5.5l7.1 4.1v2.1l-7.1-2v3.8l2.2 1.6v1.5L12 19.3l-3.6.7v-1.5l2.2-1.6v-3.8l-7.1 2v-2.1l7.1-4.1V3.4Z"/><path d="M12 6.2v2.7" class="accent"/>`,
	shield: `<path d="M12 3.3 5.6 5.9v5.2c0 3.9 2.6 7.4 6.4 8.9 3.8-1.5 6.4-5 6.4-8.9V5.9L12 3.3Z"/><path d="m9.4 11.7 1.9 1.9 3.5-3.7" class="accent"/>`,
	planet: `<circle cx="12" cy="12" r="5.2"/><ellipse cx="12" cy="12" rx="9.6" ry="3.3" transform="rotate(-22 12 12)" class="accent"/>`,
	antenna: `<circle cx="12" cy="6.4" r="1.7"/><path d="m12 8.1-3 11.5M12 8.1l3 11.5M9.9 15.6h4.2"/><path d="M8.5 9.6a4.6 4.6 0 0 1 0-6.4M15.5 3.2a4.6 4.6 0 0 1 0 6.4" class="accent"/>`,

	// Valeurs
	people: `<circle cx="9.3" cy="8.4" r="3.2"/><path d="M3.6 19.4a5.7 5.7 0 0 1 11.4 0"/><circle cx="17.3" cy="9.6" r="2.3" class="accent"/><path d="M16.4 14.2a4.7 4.7 0 0 1 4.1 5.2" class="accent"/>`,
	heart: `<path d="M12 20s-7.5-4.7-7.5-9.6a4.3 4.3 0 0 1 7.5-2.9 4.3 4.3 0 0 1 7.5 2.9C19.5 15.3 12 20 12 20Z"/><path d="M8.2 10.6a1.9 1.9 0 0 1 1.9-1.9" class="accent"/>`,

	// Atouts recrutement
	gem: `<path d="M7.3 4h9.4l3.6 5-8.3 10.5L3.7 9l3.6-5Z"/><path d="M3.7 9h16.6M9.5 9 12 19.5 14.5 9 12 4 9.5 9Z" class="accent"/>`,
	target: `<circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="4.2"/><path d="M12 12h.01" class="accent" stroke-width="3.2"/>`,
	chart: `<path d="M4 20h16"/><rect x="5.7" y="12.4" width="3.4" height="7.6" rx="1.2"/><rect x="10.3" y="8.8" width="3.4" height="11.2" rx="1.2"/><rect x="14.9" y="4.8" width="3.4" height="15.2" rx="1.2" class="accent"/>`,
	coast: `<circle cx="12" cy="8.6" r="3.4" class="accent"/><path d="M3 15.9c1.5 0 1.5 1.5 3 1.5s1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5"/><path d="M3 19.7c1.5 0 1.5 1.5 3 1.5s1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5"/>`,

	// Fiche « en bref »
	briefcase: `<rect x="3.2" y="7.4" width="17.6" height="12.4" rx="2.6"/><path d="M9 7.4V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.4" class="accent"/><path d="M3.2 12.6h17.6"/>`,
	pin: `<path d="M12 20.8s6.4-6.1 6.4-10.3a6.4 6.4 0 1 0-12.8 0c0 4.2 6.4 10.3 6.4 10.3Z"/><circle cx="12" cy="10.3" r="2.4" class="accent"/>`,
	sectors: `<rect x="3.4" y="3.4" width="7.2" height="7.2" rx="2.2"/><rect x="13.4" y="3.4" width="7.2" height="7.2" rx="2.2" class="accent"/><rect x="3.4" y="13.4" width="7.2" height="7.2" rx="2.2" class="accent"/><rect x="13.4" y="13.4" width="7.2" height="7.2" rx="2.2"/>`,
	star: `<path d="m12 3.6 2.6 5.3 5.8.85-4.2 4.1 1 5.8L12 16.9l-5.2 2.75 1-5.8-4.2-4.1 5.8-.85L12 3.6Z"/>`,

	// Contact
	mail: `<rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.6"/><path d="m4.6 7.6 6.5 4.9a1.5 1.5 0 0 0 1.8 0l6.5-4.9" class="accent"/>`,
	phone: `<path d="M7.9 3.6H6a2.4 2.4 0 0 0-2.4 2.5c0 7.9 6.4 14.3 14.3 14.3a2.4 2.4 0 0 0 2.5-2.4v-1.9l-4.2-1.6-1.9 1.9a13.4 13.4 0 0 1-5.3-5.3l1.9-1.9L7.9 3.6Z"/>`,
	chat: `<path d="M20.6 12.1c0 3.9-3.9 7.1-8.6 7.1a10 10 0 0 1-2.8-.4l-4.8 1.7 1.4-3.7a6.8 6.8 0 0 1-2.4-4.7C3.4 8.2 7.3 5 12 5s8.6 3.2 8.6 7.1Z"/><path d="M9 12h.01M12 12h.01M15 12h.01" class="accent" stroke-width="2.4"/>`,
	linkedin: `<rect x="3.4" y="3.4" width="17.2" height="17.2" rx="3.4"/><path d="M8 10.6v5.9M8 7.7v.01" stroke-width="2"/><path d="M11.9 16.5v-3.3a2.15 2.15 0 0 1 4.3 0v3.3" class="accent"/>`,
};

const shape = shapes[name] ?? shapes.star;
---

<svg
	class:list={['icon', className]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={shape}
/>
