---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'actus'>;
	/** La première carte d'une liste porte souvent la plus grande image : on la charge sans délai. */
	eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, date, excerpt, cover, coverAlt } = entry.data;

const dateLabel = date.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

/* Matière première de la recherche de la page actu : accents retirés pour
   qu'une recherche « evenement » trouve « Événements ». */
const haystack = [title, excerpt]
	.filter(Boolean)
	.join(' ')
	.toLowerCase()
	.normalize('NFD')
	.replace(/\p{Diacritic}/gu, '');
---

<article class="actu-card" data-actu data-haystack={haystack}>
	<a href={`/actus/${entry.id}`} class="actu-card__link">
		<div class="actu-card__media">
			{
				cover ? (
					<Image
						src={cover}
						alt={coverAlt ?? ''}
						widths={[400, 800]}
						sizes="(max-width: 620px) 100vw, 360px"
						format="webp"
						loading={eager ? 'eager' : 'lazy'}
					/>
				) : (
					<div class="actu-card__placeholder" aria-hidden="true">
						🫐
					</div>
				)
			}
		</div>

		<div class="actu-card__body">
			<time datetime={date.toISOString()}>{dateLabel}</time>
			<h3>{title}</h3>
			{excerpt && <p>{excerpt}</p>}
			<span class="actu-card__more">Lire l’article →</span>
		</div>
	</a>
</article>

<style>
	.actu-card {
		height: 100%;
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius);
		overflow: hidden;
		box-shadow: var(--bb-shadow);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.actu-card:hover {
		transform: translateY(-3px);
		border-color: var(--bb-border-strong);
		box-shadow: var(--bb-shadow-lift);
	}

	.actu-card__link {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		height: 100%;
	}

	.actu-card__media {
		position: relative;
		aspect-ratio: 16 / 10;
		background: var(--bb-bg-lav);
		overflow: hidden;
	}

	.actu-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease;
	}

	.actu-card:hover .actu-card__media img {
		transform: scale(1.04);
	}

	.actu-card__placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: 2.2rem;
	}

	.actu-card__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 0.95rem 1rem;
	}

	.actu-card__body time {
		display: block;
		font-size: 0.8rem;
		color: var(--bb-muted);
		margin-bottom: 0.25rem;
	}

	.actu-card__body h3 {
		font-size: 1.05rem;
		margin-bottom: 0.3rem;
	}

	/* Un résumé bavard ne doit pas étirer toute la rangée : trois lignes, puis
	   l'article prend le relais. */
	.actu-card__body p {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		font-size: 0.89rem;
		color: var(--bb-muted);
		margin-bottom: 0.6rem;
	}

	.actu-card__more {
		margin-top: auto;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--bb-orange);
	}
</style>
