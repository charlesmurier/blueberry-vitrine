---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'actus'>;
	/** La première carte d'une liste porte souvent la plus grande image : on la charge sans délai. */
	eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, date, category, excerpt, cover, coverAlt } = entry.data;

const dateLabel = date.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

/* Matière première du filtre de la page actu : accents retirés pour qu'une
   recherche « evenement » trouve « Événements ». */
const haystack = [title, excerpt, category]
	.filter(Boolean)
	.join(' ')
	.toLowerCase()
	.normalize('NFD')
	.replace(/\p{Diacritic}/gu, '');
---

<article class="actu-card" data-actu data-category={category} data-haystack={haystack}>
	<a href={`/actus/${entry.id}`} class="actu-card__link">
		<div class="actu-card__media">
			{
				cover ? (
					<Image
						src={cover}
						alt={coverAlt ?? ''}
						widths={[400, 800]}
						sizes="(max-width: 620px) 100vw, 360px"
						format="webp"
						loading={eager ? 'eager' : 'lazy'}
					/>
				) : (
					<div class="actu-card__placeholder" aria-hidden="true">
						🫐
					</div>
				)
			}
			<span class="actu-card__badge">{category}</span>
		</div>

		<div class="actu-card__body">
			<time datetime={date.toISOString()}>{dateLabel}</time>
			<h3>{title}</h3>
			{excerpt && <p>{excerpt}</p>}
			<span class="actu-card__more">Lire l’article →</span>
		</div>
	</a>
</article>

<style>
	.actu-card {
		height: 100%;
		background: #fff;
		border: 1px solid var(--bb-border);
		border-radius: var(--bb-radius);
		overflow: hidden;
		box-shadow: var(--bb-shadow);
		transition: transform 0.18s ease, box-shadow 0.18s ease;
	}

	.actu-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--bb-shadow-lift);
	}

	.actu-card__link {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		height: 100%;
	}

	.actu-card__media {
		position: relative;
		aspect-ratio: 4 / 3;
		background: var(--bb-bg-lav);
	}

	.actu-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.actu-card__placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: 2.5rem;
	}

	.actu-card__badge {
		position: absolute;
		left: 0.75rem;
		bottom: 0.75rem;
		background: rgb(255 255 255 / 94%);
		color: var(--bb-plum-700);
		font-family: var(--bb-font-head);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
	}

	.actu-card__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.1rem;
	}

	.actu-card__body time {
		display: block;
		font-size: 0.82rem;
		color: var(--bb-muted);
		margin-bottom: 0.35rem;
	}

	.actu-card__body h3 {
		font-size: 1.1rem;
		margin-bottom: 0.4rem;
	}

	.actu-card__body p {
		font-size: 0.91rem;
		color: var(--bb-muted);
		margin-bottom: 0.75rem;
	}

	.actu-card__more {
		margin-top: auto;
		font-family: var(--bb-font-head);
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--bb-orange);
	}
</style>
