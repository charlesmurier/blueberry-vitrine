---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Titre complet sans le suffixe « · Blueberry Digital Services » */
	rawTitle?: boolean;
}

const {
	title,
	description = "Blueberry Digital Services, société de conseil experte en informatique et numérique à Sophia-Antipolis. L'humain passe avant tout.",
	rawTitle = false,
} = Astro.props;

const fullTitle = rawTitle ? title : `${title} · ${company.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.blueberryds.com');
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={company.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	</head>
	<body>
		<a href="#contenu" class="skip-link">Aller au contenu</a>

		{/* Taches colorées diffuses : tout le décor de fond du site tient ici. */}
		<div class="page-blobs" aria-hidden="true">
			<span></span><span></span><span></span>
		</div>

		<Header />
		<main id="contenu">
			<slot />
		</main>
		<Footer />

		<style>
			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--bb-plum-900);
				color: #fff;
				padding: 0.75rem 1.25rem;
				border-radius: 0 0 8px;
			}

			.skip-link:focus {
				left: 0;
			}
		</style>
	</body>
</html>
